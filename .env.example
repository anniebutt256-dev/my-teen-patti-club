# MY TEEN PATTI CLUB — environment (copy to .env, never commit real secrets)
SESSION_SECRET=change-me-to-a-long-random-string
# Production database (Phase 7). Unset = in-memory dev store.
# DATABASE_URL=postgresql://user:pass@host:5432/teenpatti
# Public base URL used in invite links.
# PUBLIC_BASE_URL=https://your-domain.example
# Mobiles (E.164, comma-separated) promoted to ADMIN at login (OTP path).
# ADMIN_MOBILES=+92xxxxxxxxxx
# Free-launch owner bootstrap (no SMS provider): if NO user exists yet, the
# first username+password login with exactly these credentials creates the
# owner's ADMIN account. Set both in the hosting dashboard, never in code.
# OWNER_USERNAME=club_owner
# OWNER_PASSWORD=choose-a-strong-password
